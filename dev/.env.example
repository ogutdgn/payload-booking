# Local PostgreSQL for the dev bench (spec §4.4). db-postgres creates the database if missing.
DATABASE_URL=postgres://dog1to@localhost:5432/payload_booking_dev

# Payload's own secret (admin sessions).
PAYLOAD_SECRET=dev-only-change-me

# Booking plugin HMAC secret. Must be >= 32 chars and DIFFERENT from PAYLOAD_SECRET.
# Generate with: openssl rand -base64 32
BOOKING_TOKEN_SECRET=dev-only-booking-secret-change-me-32+
